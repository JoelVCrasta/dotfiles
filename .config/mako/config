font=JetBrainsMono Nerd Font
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=eDP-1
layer=overlay
anchor=bottom-right
background-color=#282828
width=400
height=100
margin=5
padding=5,10,5,10
border-size=1
border-color=#98971a
border-radius=5
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1

[urgency=normal]
border-color=#98971a

[urgency=high]
border-color=#cc241d
default-timeout=0

[summary~="log-.*"]
border-color=#458588
