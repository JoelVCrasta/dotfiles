(defwidget bar []
  (centerbox :orientation "h"
    (title)
    (middle)
    (control)))

(defwidget middle []
  (centerbox :orientation "h"
             :class "middle"
             :width 840
    (music)
    (workspaces)
    (midleft)))

(defwidget midleft []
  (box :space-evenly false
    (clock)
    (bluelight)))

(defwidget clock []
  (box :class "clock"
       :orientation "h"
       :space-evenly false
       :halign "start"
       :spacing 10
  (label :class "time"
         :text "${time}")
  (label :class "dot"
         :text "●")
  (label :class "date"
         :text "${date}")))

(defwidget bluelight []
(box :orientation "h"
     :space-evenly true
     :halign "start" 
  (button :class {(bluelight_active == "true") ? "bluelight-on" : "bluelight-off"}
          :onclick "scripts/bluelight.sh" 
          "󰤄")))

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly true
       :halign "center"
       :spacing 2
    (workspace-button :id 1)
    (workspace-button :id 2)
    (workspace-button :id 3)
    (workspace-button :id 4)
    (workspace-button :id 5)
    (workspace-button :id 6)
    (workspace-button :id 7)
    (workspace-button :id 8)
    (workspace-button :id 9)))

(defwidget workspace-button [id]
  (button :class {active_workspace == id ? "active" : ""}
          :onclick "hyprctl dispatch workspace ${id}"
          id))

(defwidget music []
  (box :class {(music_status == "Playing") ? "playing" : "paused"}
       :orientation "h"
       :space-evenly false
       :halign "end"
       :spacing {(music != "") ? 10 : 0}
    (box :class "music-progress"
         :width {(music != "") ? 24 : 0}
         :halign "start"
         (circular-progress
           :class {(music_status == "Playing") ? "playing-circle" : "paused-circle"}
           :value {(music_progress / music_length) * 100}
           :thickness 2.5
           :clockwise true
           :start-at 73
           (button :onclick "scripts/music.sh play-pause" 
                   "${(music != "") ? ((music_status == "Playing") ? "" : "") : ""}")))
    (label :class "music-text"
           :halign "start"
           :limit-width 28
           :text "${(music != "") ? "${music}" : "≧◉◡◉≦ | nothing is playing"}")))

(defwidget title []
  (box :class "title"
       :orientation "h"
       :space-evenly true
       :halign "start"
    (label :limit-width 40 
           :text "${(window_title != "null") ? window_title : " Hyprland"}")))

(defwidget control []
  (box :class "control"
       :orientation "h"
       :space-evenly false
       :halign "end"
       :spacing 10
    (volume)
    (brightness)
    (warp)
    (battery)
    (label :class "control-dot"
           :text "•")
    (stats)
    (tray)))

(defwidget stats []
  (box :class "ram"
       :orientation "h"
       :spacing 8
       :halign "center"
    (box :class "cpu-progress"
         :width 24
         :halign "start"
         (circular-progress
           :class "cpu-circle"
           :value {EWW_CPU.avg}
           :thickness 2
           :clockwise true
           :start-at 73
           (label :text "󰍛")))
    (box :class "ram-progress"
         :width 24
         :halign "start"
         (circular-progress
           :class "ram-circle"
           :value {EWW_RAM.used_mem_perc}
           :thickness 2
           :clockwise true
           :start-at 73
           (label :text "󰘚")))
    (box :class "disk-progress"
         :width 24
         :halign "start"
         (circular-progress
           :class "disk-circle"
           :value {EWW_DISK["/"].used_perc}
           :thickness 2
           :clockwise true
           :start-at 73
           (label :text "󰆼")))))

(defwidget volume []
  (eventbox
    :onhover "eww update vol=true"
    :onhoverlost "eww update vol=false"
    (box :orientation "h"       
               :space-evenly "false"
      (revealer :transition "slideleft"
                :reveal vol
                :duration "200ms"
        (box :space-evenly "false"
          (scale :class "volbar"       
          :value curr_volume
          :orientation "h"      
          :max 101
          :min 0
          :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
          (label :class "volume-value" :text "${curr_volume}%")))
      (button :class "volume-icon"
              :onclick "scripts/volume.sh" 
              {volume_muted == "true" ? "󰝟" : "󰕾"}))))

(defwidget battery []
  (box  :orientation "h"    
        :space-evenly "false"
    (label  :class "battery"        
            :halign "end"        
            :text "${bat_icon}")
    (label  :class "battery-percent"
              :text "${bat_cap}%")))

(defwidget warp []
  (box  :orientation "h"    
        :space-evenly "false"
    (button :class "warp"
            :onclick "scripts/warp.sh toggle"
            {warp_active == "true" ? "󰕥" : "󰦞"})))

(defwidget brightness []
  (eventbox :onhover "eww update bright=true"   
              :onhoverlost "eww update bright=false"
              (box  :orientation "h"  
                        :space-evenly "false"  
                (revealer :transition "slideleft" 
                              :reveal bright   
                              :duration "200ms"
            (box :space-evenly "false"
              (scale :class "brightness" 
                :value curr_brightness 
                :onchange "brightnessctl set {}%" 
                :orientation "h" 
                :max 101 
                :min 0)
              (label :class "brightness-value" :text "${curr_brightness}%")))
              (label :class "brightness-icon" :text "󰃠"))))

(defwidget tray []
  (systray 
    :class "tray"
    :orientation "h"
    :spacing 6
    :icon-size 16
    :prepend-new false))



(deflisten music :initial "" 
  "playerctl --follow metadata --format '{{artist}} | {{ title }}' || true")

(defpoll music_progress :interval "2s"
  "playerctl position || echo 0")

(defpoll music_length :interval "2s"
  "playerctl metadata mpris:length | awk '{print $1 / 1000000}' || echo 1")

(defpoll music_status :interval "1s"
  "playerctl status || echo 'Stopped'")

(defpoll time :interval "10s"
  "date '+%I:%M'")

(defpoll date :interval "60s"
  "date '+%A, %m/%d'")

(defpoll window_title :interval "0.2s"
  "hyprctl activewindow -j | jq -r '.title'")

(defpoll active_workspace :interval "0.2s"
  "hyprctl activeworkspace -j | jq -r '.id'")

(defpoll volume_muted :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q '\\[MUTED\\]' && echo true || echo false")

(defpoll curr_volume :interval "1s" 
  "pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | tr -d '%'")

(defpoll curr_brightness :interval "1s" 
  "brightnessctl -m | awk -F, '{print substr($4, 0, length($4)-1)}' | tr -d '%'")

(defpoll bluelight_active :interval "1s"
  "pgrep -x 'hyprsunset' > /dev/null && echo true || echo false")

(defpoll bat_icon :interval "10s"
    "scripts/battery.sh icon")

(defpoll bat_cap :interval "10s"
    "scripts/battery.sh percent")

(defpoll warp_active :interval "0.1s"
    "scripts/warp.sh status")

(defvar vol false)
(defvar bright false)