(include "./widgets/bar.yuck")


(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0px"
                      :y "4px"
                      :width "99.6%"
                      :height "36px"
                      :anchor "top center" )
  :reserve (struts :side "top" :distance "0%")
  :exclusive true
  (bar)
)
