(include "widgets/bar.yuck")

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "40px"
                      :anchor "top center" )
  :reserve (struts :side "top" :distance "0%")
  :exclusive true
  (bar)
)