(include "widgets/bar.yuck")
(include "widgets/music_player.yuck")

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "40px"
                      :anchor "top center" )
  :reserve (struts :side "top" :distance "0%")
  :exclusive true
  (bar)
)

(defwindow music_player
  :monitor 0
  :windowtype "normal"
  :geometry (geometry :x "570px"
                      :y "6px"
                      :width "430px"
                      :height "120px")
  :exclusive false
  :focusable false
  (music_player)
)
